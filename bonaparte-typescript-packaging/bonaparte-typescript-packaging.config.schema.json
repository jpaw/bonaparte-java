{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["artifactName"],
  "properties": {
    "artifactName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "generatedSourceDirectory": {
      "type": "string"
    },
    "managedDependencyVersions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "consumerFile": {
      "type": "string"
    },
    "expectedExports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
